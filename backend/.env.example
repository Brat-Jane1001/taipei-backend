SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase Dashboard → Project Settings → API Keys → Secret key (sb_secret_...)
# 不要放 publishable key，也不要 commit 真正的 .env
SUPABASE_KEY=sb_secret_xxxxxxxx
# 後台管理密碼，自己訂一組夠長的
ADMIN_KEY=change-me-to-a-long-random-string
# TDX 金鑰（公車路線與即時位置）。原本寫在 App 程式碼裡的那組請到 TDX 重新產生
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# 分享連結的網址（選填，不填就用請求的網域）
PUBLIC_URL=https://tpdgt.onrender.com
PORT=3000
